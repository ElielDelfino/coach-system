# Copiar para .env e preencher os valores reais
# NUNCA commitar o .env com valores reais

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_DB=coach_db
POSTGRES_USER=coach_user
POSTGRES_PASSWORD={}        # senha forte — nunca commitar o valor real

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD='bH1Pz53FfTSOKB+CWvFg+yP4ac4GDGmt'            # senha forte — nunca commitar o valor real

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET={}         # gerar com: openssl rand -base64 64
JWT_REFRESH_SECRET={}      # gerar com: openssl rand -base64 64

# ─────────────────────────────────────────
# Backend
# ─────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─────────────────────────────────────────
# Observações
# ─────────────────────────────────────────
# DATABASE_URL é montada automaticamente pelo docker-compose:
# postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}
#
# REDIS_URL é montada automaticamente:
# redis://:${REDIS_PASSWORD}@cache:6379


# ─────────────────────────────────────────
# Resend
# ─────────────────────────────────────────
RESEND_API_KEY={}         # chave de API do Resend — nunca commitar o valor real
EMAIL_FROM=onboarding@resend.dev

# ─────────────────────────────────────────
# AWS
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID={}
AWS_SECRET_ACCESS_KEY={}
AWS_REGION=us-east-1
AWS_S3_BUCKET=coach-system-uploads
S3_PUBLIC_URL=https://coach-system-uploads.s3.us-east-1.amazonaws.com
