# .env.prod.example — Copie para .env.prod e preencha os valores reais
# NUNCA commitar .env.prod no repositório

# ─────────────────────────────────────────
# Domínio (obrigatório para SSL e nginx)
# ─────────────────────────────────────────
DOMAIN=app.seudominio.com.br

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_DB=coach_db
POSTGRES_USER=coach_user
POSTGRES_PASSWORD=              # gere com: openssl rand -base64 32

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=                 # gere com: openssl rand -base64 32

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET=                     # gere com: openssl rand -base64 64
JWT_REFRESH_SECRET=             # gere com: openssl rand -base64 64

# ─────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────
RESEND_API_KEY=                 # https://resend.com → API Keys
EMAIL_FROM=noreply@seudominio.com.br

# ─────────────────────────────────────────
# AWS S3 (fotos de perfil, vídeos)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=coach-system-uploads
S3_PUBLIC_URL=https://coach-system-uploads.s3.us-east-1.amazonaws.com

# ─────────────────────────────────────────
# Backblaze B2 (backups do banco)
# ─────────────────────────────────────────
B2_BUCKET=coach-backups         # nome do bucket criado no Backblaze
BACKUP_RETENTION_DAYS=14        # quantos dias guardar backups
